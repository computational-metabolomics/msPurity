{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mzstack:schema:variables:0.1",
  "title": "mzStack spectra variable registry",
  "description": "Schema for schemas/variables.json, the machine-readable form of the canonical spectra variables (mzStack-1 §5.1; [D-042]), the reserved storage columns (mzStack-1 §4) and the MassQL frame columns (mzStack-2 §5).",
  "type": "object",
  "required": [
    "title",
    "version",
    "variables",
    "storage_columns",
    "frames"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "storage_columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storageColumn"
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frameColumn"
      }
    }
  },
  "$defs": {
    "arrowType": {
      "enum": [
        "int32",
        "int64",
        "float64",
        "bool",
        "string",
        "dict<string>",
        "list<float64>"
      ]
    },
    "unit": {
      "type": "object",
      "required": [
        "accession",
        "label"
      ],
      "properties": {
        "accession": {
          "type": "string",
          "pattern": "^[A-Za-z]+:[0-9]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nullableUnit": {
      "oneOf": [
        {
          "$ref": "#/$defs/unit"
        },
        {
          "type": "null"
        }
      ]
    },
    "indexBase": {
      "enum": [
        0,
        1,
        null
      ],
      "description": "0 or 1 for a position or key; null where the value is not a position."
    },
    "candidate": {
      "type": "object",
      "required": [
        "columns",
        "sql"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "description": "SQL over the storage columns named in columns."
        }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": [
        "name",
        "type",
        "nullable",
        "unit",
        "index_base",
        "spectra_core",
        "source",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "Canonical name: the Spectra variable name [D-041]."
        },
        "type": {
          "$ref": "#/$defs/arrowType"
        },
        "nullable": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/nullableUnit"
        },
        "index_base": {
          "$ref": "#/$defs/indexBase"
        },
        "spectra_core": {
          "type": "boolean",
          "description": "True where the name is a Spectra core variable."
        },
        "source": {
          "enum": [
            "storage",
            "derived",
            "implementation",
            "none"
          ],
          "description": "storage: produced by the first usable storage candidate. derived: computed by the view from other variables and the manifest. implementation: supplied by the implementation. none: always a typed null."
        },
        "storage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "description": "Ordered candidates; the first whose columns are all present wins [D-039]."
        },
        "storage_unit": {
          "$ref": "#/$defs/unit",
          "description": "The unit on disk, where it differs from unit."
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "source": {
            "const": "storage"
          }
        }
      },
      "then": {
        "required": [
          "storage"
        ]
      },
      "else": {
        "not": {
          "required": [
            "storage"
          ]
        }
      }
    },
    "storageColumn": {
      "type": "object",
      "required": [
        "name",
        "type",
        "reserved",
        "index_base",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/arrowType"
        },
        "reserved": {
          "type": "boolean",
          "description": "True for a column mzStack reserves because mzPeak has no equivalent [D-031]."
        },
        "index_base": {
          "$ref": "#/$defs/indexBase"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "frameColumn": {
      "type": "object",
      "required": [
        "name",
        "frames",
        "source",
        "conversion",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MS1",
              "MS2"
            ]
          }
        },
        "source": {
          "type": "string",
          "description": "The canonical variable, or spectrum_id_, the column is taken from."
        },
        "conversion": {
          "type": [
            "string",
            "null"
          ],
          "description": "The conversion applied at the MassQL boundary, or null for none [G-012]."
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}